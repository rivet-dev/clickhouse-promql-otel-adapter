          "shape": "value",
          "sql": "SELECT t, labels, sum(value) AS value, throwIf(uniqExact(labels) OVER () > 1000, 'rivet_series_limit') AS series_limit\nFROM (\n\tSELECT t, series, labels, (if(dateDiff('second', before_at, first_at) > 300, 0, if(first >= before, first - before, first)) + if(last >= peak, last - first, peak - first + last)) / {step:UInt32} AS value\n\tFROM (\n\t\tSELECT t, series, labels, first, last, peak, first_at, lagInFrame(last, 1, first) OVER (PARTITION BY series ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before, lagInFrame(last_at, 1, first_at) OVER (PARTITION BY series ORDER BY t ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before_at\n\t\tFROM (\n\t\t\tSELECT toUInt32({from:UInt32} + {step:UInt32} * ceil((toUnixTimestamp64Nano(toDateTime64(TimeUnix, 9)) - toInt64({from:UInt32}) * 1000000000) / ({step:UInt32} * 1000000000))) AS t, cityHash64(ResourceAttributes['service.name'], ResourceAttributes['service.instance.id'], Attributes) AS series, mapFilter((k, v) -> v != '', mapUpdate(map('job', any(ResourceAttributes['service.name']), 'instance', any(ResourceAttributes['service.instance.id'])), any(Attributes))) AS all_labels, mapFilter((k, v) -> v != '', CAST(map('pod', all_labels['pod']), 'Map(String, String)')) AS labels, argMin(toFloat64(Value), TimeUnix) AS first, argMax(toFloat64(Value), TimeUnix) AS last, max(toFloat64(Value)) AS peak, min(TimeUnix) AS first_at, max(TimeUnix) AS last_at\n\t\t\tFROM otel_metrics_sum\n\t\t\t\tWHERE ProjectId = {project:String}\n\t\t\t\t\tAND TimeUnix >= toDateTime({query_from:UInt32})\n\t\t\t\t\tAND TimeUnix <= toDateTime({to:UInt32})\n\t\t\t\t\tAND bitAnd(Flags, 1) = 0\n\t\t\t\t\tAND MetricName IN ('rivet_guard_requests_total', 'rivet_guard_requests')\n\t\t\tGROUP BY t, series\n\t\t)\n\t)\n\tWHERE t >= {from:UInt32} AND t <= {to:UInt32}\n)\nGROUP BY t, labels\nORDER BY labels, t"
