jectId = {project:String}\n\t\t\t\t\t\t\tAND TimeUnix >= toDateTime({query_from:UInt32})\n\t\t\t\t\t\t\tAND TimeUnix <= toDateTime({to:UInt32})\n\t\t\t\t\t\t\tAND bitAnd(Flags, 1) = 0\n\t\t\t\t\t\t\tAND MetricName = 'rivet_state_machine_effect_seconds'\n\t\t\t\t\tGROUP BY t, series, bounds\n\t\t\t\t)\n\t\t\t)\n\t\t\tWHERE t >= {from:UInt32} AND t <= {to:UInt32}\n\t\t)\n\t\tGROUP BY t, labels, bounds\n\t)\n\tGROUP BY t, labels\n)\nORDER BY labels, t"
