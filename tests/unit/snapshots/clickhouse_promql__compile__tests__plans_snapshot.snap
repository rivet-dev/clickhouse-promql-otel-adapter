          "shape": "value",
          "sql": "SELECT t, labels, sum(value) AS value, throwIf(uniqExact(labels) OVER () > 1000, 'rivet_series_limit') AS series_limit\nFROM (\n\tSELECT t, any(labels) AS labels, sum(growth) / {step:UInt32} AS value\n\tFROM (\n\t\tSELECT toUnixTimestamp(toStartOfInterval(TimeUnix, toIntervalSecond({step:UInt32}))) AS t, cityHash64(ResourceAttributes['service.instance.id'], Attributes) AS series, mapFilter((k, v) -> v != '', mapUpdate(map('job', ResourceAttributes['service.name'], 'instance', ResourceAttributes['service.instance.id']), Attributes)) AS all_labels, mapFilter((k, v) -> v != '', CAST(map('pod', all_labels['pod']), 'Map(String, String)')) AS labels, TimeUnix, lagInFrame(Value, 1, Value) OVER (PARTITION BY series ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before, lagInFrame(TimeUnix, 1, TimeUnix) OVER (PARTITION BY series ORDER BY TimeUnix ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS before_at, if(dateDiff('second', before_at, TimeUnix) > 300, 0, if(Value >= before, toFloat64(Value - before), toFloat64(Value))) AS growth\n\t\tFROM otel_metrics_sum\n\t\t\tWHERE ProjectId = {project:String}\n\t\t\t\tAND TimeUnix >= toDateTime({query_from:UInt32})\n\t\t\t\tAND TimeUnix < toDateTime({to:UInt32})\n\t\t\t\tAND bitAnd(Flags, 1) = 0\n\t\t\t\tAND MetricName IN ('rivet_guard_requests_total', 'rivet_guard_requests')\n\t)\n\tWHERE t >= {from:UInt32}\n\tGROUP BY t, series\n)\nGROUP BY t, labels\nORDER BY labels, t"
        }
      ],
      "tree": {
        "index": 0,
        "op": "leaf"
      }
    }
